# ===================================================================
#  Configuration Environnement Docker — BCRG HUB
# ===================================================================

# Port public d'accès au portail (ex: 3001)
PORT=3001

# Base de Données PostgreSQL
DB_NAME=bcrg_hub
DB_USER=postgres
DB_PASSWORD=BcrgSecureDbPassword2026!
DB_PORT=5432

# Sécurité & Clés Cryptographiques
JWT_SECRET=bcrg_hub_super_secret_jwt_key_a_changer_en_production_2026
ENCRYPTION_KEY=bcrg_cle_chiffrement_32_octets_aes_secrets_au_repos

# Compte Super Administrateur initial (créé automatiquement au premier démarrage)
DEFAULT_ADMIN_EMAIL=admin@bcrg-guinee.org
DEFAULT_ADMIN_PASSWORD=Bcrg@Admin2026!
DEFAULT_ADMIN_MATRICULE=ADMIN001

# Activation du mode HTTPS strict (Mettre "true" si SSL/TLS activé)
USE_HTTPS=false
