# Configuration Environnement BCRG HUB Backend
NODE_ENV=production
PORT=5001

# Base de données PostgreSQL BCRG HUB
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=bcrg_hub
DB_SSL=false # Mettre à true pour Render ou PostgreSQL managé (SSL/TLS)

# Sécurité & Chiffrement
JWT_SECRET=your_jwt_secret_change_in_production
ENCRYPTION_KEY=your_32_byte_hex_or_string_key_for_secrets_at_rest

# Clés asymétriques RSA pour signature RS256 du SSO (Recommandé en production)
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_PRIVATE_KEY_PATH=./private.pem
# JWT_PUBLIC_KEY_PATH=./public.pem

# CORS et URL Frontend en production
FRONTEND_URL=http://localhost:5173
USE_HTTPS=false # Mettre à true en production derrière un domaine HTTPS

# Administrateur par défaut à l'initialisation
DEFAULT_ADMIN_EMAIL=admin@bcrg.local
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_MATRICULE=ADMIN001
